# Copy to .env and fill in from Supabase Dashboard -> Project Settings -> API.
# The anon key is safe to ship in the client (RLS + closed signups protect the data).
# NEVER put the service_role key here or anywhere in this repo.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
